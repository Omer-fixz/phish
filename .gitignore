# ============ البيانات ============
# لا يُرفع أي شيء داخل data/:
#   raw/       كبير (31 ميجابايت) ويُنزَّل بالأوامر المذكورة في README
#   processed/ يُعاد توليده بأمر واحد من raw
data/*
!data/raw/
!data/processed/
data/raw/*
data/processed/*

# نسخة قديمة من المصدر بقيت في الجذر لأن Excel كان يقفلها وقت النقل.
# النسخة المعتمدة في data/raw/ — احذف هذه بعد إغلاق Excel.
/Final_Phishing_Dataset_96k.csv

# ============ مخرجات التدريب ============
models/*
reports/figures/*
reports/tables/*

# ============ استثناء مضاد ============
# نُبقي .gitkeep في كل مجلد مخرجات ليعرف من يستنسخ المشروع أين توضع الملفات
!**/.gitkeep

# ============ بايثون ============
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# ============ أسرار ============
.env
*.key
*.pem

# ============ نظام التشغيل والمحررات ============
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

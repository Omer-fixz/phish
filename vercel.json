{
  "version": 2,
  "builds": [
    {
      "src": "src/api/main.py",
      "use": "@vercel/python",
      "config": {
        "excludeFiles": "{data/**,reports/**,scripts/**,tests/**,archive/**,data/raw/**,data/processed/**,*.csv,*.zip,*.gz}"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/api/main.py"
    }
  ]
}
